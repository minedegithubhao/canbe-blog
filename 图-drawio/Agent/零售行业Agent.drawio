        </mxCell>
        <mxCell id="BOY22OA9ZzY5tOW-Ic-X-12" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;2、确认滞销规则（专家评估）&lt;/h1&gt;&lt;pre&gt;&lt;code&gt;例如：库存周转天数 &amp;gt; 阈值&lt;br&gt;且 最近 N 天销量低于品类均值&lt;br&gt;且 售罄率低于同类商品&lt;br&gt;且 非新品冷启动期&lt;/code&gt;&lt;/pre&gt;" vertex="1">
          <mxGeometry height="130" width="330" x="531" y="-114" as="geometry" />
        </mxCell>
        <mxCell id="BOY22OA9ZzY5tOW-Ic-X-15" edge="1" parent="1" source="BOY22OA9ZzY5tOW-Ic-X-13" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;align=left;" target="BOY22OA9ZzY5tOW-Ic-X-14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BOY22OA9ZzY5tOW-Ic-X-13" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;3、根因诊断&lt;/h1&gt;&lt;pre&gt;&lt;code&gt;价格问题&lt;br&gt;库存问题&lt;br&gt;区域错配&lt;br&gt;促销无效&lt;br&gt;商品生命周期问题&lt;br&gt;品类整体下滑&lt;br&gt;竞品/替代品影响&lt;br&gt;门店执行问题&lt;br&gt;新品冷启动失败&lt;br&gt;数据异常&lt;/code&gt;&lt;/pre&gt;" vertex="1">
          <mxGeometry height="217" width="159" x="531" y="49" as="geometry" />
        </mxCell>
        <mxCell id="BOY22OA9ZzY5tOW-Ic-X-14" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="价格问题（&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 51, 51));&quot;&gt;加权得分&lt;/font&gt;）&lt;div&gt;&lt;br&gt;- 该 SKU 价格高于同品类同价格带商品；&lt;br&gt;- 调价后销量有明显变化；&lt;br&gt;- 促销期间销量提升明显；&lt;br&gt;- 高价区域销量更差；&lt;/div&gt;" vertex="1">
          <mxGeometry height="111.5" width="293" x="810" y="26.5" as="geometry" />
        </mxCell>
        <mxCell id="BOY22OA9ZzY5tOW-Ic-X-16" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 29px; color: light-dark(rgb(0, 0, 0), rgb(255, 51, 51));&quot;&gt;阶段一：商品滞销原因分析——数据对齐&lt;/font&gt;" vertex="1">
          <mxGeometry height="66" width="589" x="531" y="-401" as="geometry" />
        </mxCell>
        <mxCell id="BOY22OA9ZzY5tOW-Ic-X-17" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;4、根因评分&lt;/h1&gt;&lt;p&gt;规则加权 （证据链）&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="180" x="528" y="328" as="geometry" />
        </mxCell>
        <mxCell id="BOY22OA9ZzY5tOW-Ic-X-18" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;5、模型训练&lt;/h1&gt;&lt;p&gt;LightGBM、XGBoost、Random Forest（可解释性）&lt;/p&gt;&lt;p&gt;-专家经验不准，机器学习更接近真实原因（权重更准）&lt;/p&gt;&lt;p&gt;-排列组合太多，规则难写&lt;/p&gt;&lt;p&gt;-&lt;/p&gt;" vertex="1">
          <mxGeometry height="139" width="291" x="528" y="498" as="geometry" />
        </mxCell>
        <mxCell id="BOY22OA9ZzY5tOW-Ic-X-19" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;1、准备核心数据&lt;/h1&gt;&lt;li&gt;商品：SKU、品类、品牌、价格带、上市时间、生命周期；&lt;/li&gt;&lt;li&gt;销售：销量、销售额、毛利、客单、退货；&lt;/li&gt;&lt;li&gt;库存：当前库存、库存金额、库龄、周转天数、断货天数；&lt;/li&gt;&lt;li&gt;门店：区域、商圈、门店等级、客流；&lt;/li&gt;&lt;li&gt;价格：原价、折扣价、竞品价、历史调价；&lt;/li&gt;&lt;li&gt;促销：活动类型、折扣力度、活动时间；&lt;/li&gt;&lt;li&gt;时间：节假日、季节、天气，如果能接入更好。&lt;/li&gt;" vertex="1">
          <mxGeometry height="160" width="326" x="526" y="-303" as="geometry" />
        </mxCell>
        <mxCell id="BOY22OA9ZzY5tOW-Ic-X-20" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;{&lt;/div&gt;&lt;div&gt;&amp;nbsp; &quot;sku&quot;: &quot;A123&quot;,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &quot;slow_moving_level&quot;: &quot;high&quot;,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &quot;root_causes&quot;: [&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;cause&quot;: &quot;价格偏高&quot;,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;score&quot;: 0.78,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;evidence&quot;: [&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;价格高于同品类中位数 18%&quot;,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;促销期间销量提升 42%&quot;,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;高价门店销量显著低于低价门店&quot;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; ],&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;suggested_action&quot;: &quot;测试性降价或组合促销&quot;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; },&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;cause&quot;: &quot;区域错配&quot;,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;score&quot;: 0.64,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;evidence&quot;: [&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;华东门店售罄率 62%，华北门店售罄率 18%&quot;,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;华北库存金额占总库存 55%&quot;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; ],&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;suggested_action&quot;: &quot;从低动销区域调拨至高动销区域&quot;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; ]&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;" vertex="1">
          <mxGeometry height="382" width="325" x="867" y="183" as="geometry" />
        </mxCell>
        <mxCell id="BOY22OA9ZzY5tOW-Ic-X-22" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;6、测试评估&lt;/h1&gt;&lt;p&gt;完善正负样本集，反哺机器学习算法&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="180" x="531" y="728" as="geometry" />
        </mxCell>
      </root>
