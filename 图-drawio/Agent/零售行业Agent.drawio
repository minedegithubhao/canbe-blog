        <mxCell id="BOY22OA9ZzY5tOW-Ic-X-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="阶段五：&lt;div&gt;AI决策系统&lt;/div&gt;" vertex="1">
