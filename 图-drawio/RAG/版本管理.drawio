        <mxCell id="ZB5yThu6v1tiOMYte4ez-124" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;text-align: center; text-wrap-mode: nowrap; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;&quot;&gt;kb_document_manifests&lt;/font&gt;&lt;/span&gt;字段说明&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;font-family: Tahoma;&quot;&gt;index_record_id =&amp;nbsp;&lt;/span&gt;&lt;font face=&quot;Tahoma&quot;&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;SHA256(manifest_key + content_cache_key)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;font face=&quot;Tahoma&quot;&gt;document_id = SHA256(tenant_id + dataset_id + source + external_file_id) ，&lt;/font&gt;&lt;span style=&quot;font-family: Tahoma; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;external_file_id为文件服务器返回的文件id，&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: rgb(151, 208, 119); font-family: Tahoma;&quot;&gt;人为决定是否是更新操作，&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;就比如需求书V1.0/V1.1&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: Tahoma;&quot;&gt;，&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: Tahoma;&quot;&gt;document_id&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: Tahoma;&quot;&gt;&amp;nbsp;在&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: Tahoma;&quot;&gt;这里表文档的唯一身份，即文档是哪个业务场景下的&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;font face=&quot;Tahoma&quot;&gt;manifest_key = SHA256(&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;tenant_id + dataset_id +&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-family: Tahoma; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;scenario_id + source + kb_version +&amp;nbsp;&lt;/span&gt;&lt;font style=&quot;font-family: Tahoma; background-color: transparent; color: rgb(0, 0, 0);&quot;&gt;document_id&lt;/font&gt;&lt;span style=&quot;font-family: Tahoma; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;）&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;，&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;它在这个知识库版本&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: Tahoma;&quot;&gt;有没有入过库&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;content_cache = SHA256(&lt;/span&gt;&lt;span style=&quot;font-family: Tahoma;&quot;&gt;fingerprint&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;+ embedding_model_version + chunk_schema_version)&lt;/span&gt;&lt;font face=&quot;Tahoma&quot;&gt;判断文件&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;这套切分策略下有没有处理过&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-family: Tahoma;&quot;&gt;文档指纹(&lt;/span&gt;&lt;span style=&quot;font-family: Tahoma;&quot;&gt;fingerprint&lt;/span&gt;&lt;span style=&quot;font-family: Tahoma;&quot;&gt;) = 路径 + 时间 + 大小 （企业中常使用文件内容制作文档指纹）&lt;/span&gt;&lt;font face=&quot;Tahoma&quot;&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-family: Tahoma; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;kb_version =&amp;nbsp;&lt;/span&gt;&lt;font face=&quot;Tahoma&quot;&gt;kb_enterprise_knowledge_20260506_103000_xxx&lt;/font&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="245" width="523.5" x="2270" y="732.5" as="geometry" />
        </mxCell>
