        <mxCell id="QvqgyQXYwZoGngIfLRK4-119" parent="1" style="whiteSpace=wrap;html=1;rounded=1;fontSize=12;fontColor=#000000;align=left;" value="&lt;span style=&quot;&quot;&gt;根据意图设置动态计划&lt;/span&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;2：查询改写：rewrite_query_if_needed（第七章）&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;3：查询变体：&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;generate_query_variants（第七章）&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="279.99" x="2910.01" y="2290" as="geometry" />
