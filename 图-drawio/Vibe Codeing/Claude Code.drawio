        <mxCell id="QvqgyQXYwZoGngIfLRK4-123" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="1、按意图调整动态计划&lt;div&gt;2、简单问题简单处理（短问题保护）&lt;div&gt;3、费用问题，调大召回、提高阈值&lt;/div&gt;&lt;/div&gt;&lt;div&gt;4、合规问题，调大召回、提高阈值&lt;/div&gt;&lt;div&gt;5、排障类问题，调大召回&lt;/div&gt;&lt;div&gt;6、总结类问题，调大召回&lt;/div&gt;&lt;div&gt;7、表格类问题，调大召回，提高阈值&lt;/div&gt;" vertex="1">
