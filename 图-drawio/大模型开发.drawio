        <mxCell id="aY2dbMntaScDE3_ggx9g-51" edge="1" parent="1" source="aY2dbMntaScDE3_ggx9g-22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="aY2dbMntaScDE3_ggx9g-24" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aY2dbMntaScDE3_ggx9g-55" edge="1" parent="1" source="aY2dbMntaScDE3_ggx9g-22" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" target="aY2dbMntaScDE3_ggx9g-54">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aY2dbMntaScDE3_ggx9g-22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="1、合并&lt;div&gt;2、去重&lt;/div&gt;&lt;div&gt;3、过滤&lt;/div&gt;&lt;div&gt;4、重排&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="120" x="508" y="3233" as="geometry" />
        </mxCell>
        <mxCell id="aY2dbMntaScDE3_ggx9g-24" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="LLM" vertex="1">
          <mxGeometry height="60" width="120" x="508" y="3418" as="geometry" />
        </mxCell>
        <mxCell id="aY2dbMntaScDE3_ggx9g-31" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;dashed=1;" value="制度 ： [chunk_id1,chunk_id2]&lt;div&gt;请假：chunk_id3&lt;/div&gt;&lt;div&gt;迟到：[chunk_id4,chunk_id5,chunk_id6]&lt;/div&gt;&lt;div&gt;也包含元数据&lt;/div&gt;" vertex="1">
          <mxGeometry height="81" width="232" x="-848" y="4636.16" as="geometry" />
        </mxCell>
        <mxCell id="aY2dbMntaScDE3_ggx9g-37" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;dashed=1;" value="&lt;div&gt;RAG 的天生缺陷：&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;1、把一整段语义压扁成单个向量，一定会丢失细节、结构、逻辑。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;2、句子越长，丢失越严重，召回越差。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;这就是为什么工业界必须搭配 query 改写、多路召回、重排模型来弥补。&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="96" width="384" x="798" y="2461" as="geometry" />
        </mxCell>
        <mxCell id="aY2dbMntaScDE3_ggx9g-45" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;dashed=1;" value="混合检索/多路召回：就是同时使用向量检索、关键词检索等多种方式召回文档。" vertex="1">
          <mxGeometry height="55" width="195" x="966" y="3136" as="geometry" />
        </mxCell>
        <mxCell id="aY2dbMntaScDE3_ggx9g-47" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;dashed=1;" value="&lt;div&gt;单 query → 混合检索（语义 + 关键词）→ 合并去重融合排序 → 业务过滤 → Top50 → Rerank → Top5&lt;/div&gt;&lt;div&gt;多 query 标准真实流程：&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;query1 → 混合检索（语义 + 关键词）→ 不分 Top50，保留全量召回结果（如 top100）&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;query2 → 混合检索（语义 + 关键词）→ 保留全量召回结果&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;把所有 query 的全量结果先合并&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;统一去重&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;统一使用 RRF/Max Score 融合排序&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;业务过滤&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;再取 Top50&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;再进 Rerank → Top5&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="166" width="565" x="-284" y="2580" as="geometry" />
        </mxCell>
        <mxCell id="aY2dbMntaScDE3_ggx9g-52" parent="1" style="rounded=1;whiteSpace=wrap;align=left;dashed=1;" value="用户输入往往口语化、碎片化、不标准，查询改写就是把用户问题提纯、标准化、对齐文档 = 升华提纯用户问题" vertex="1">
          <mxGeometry height="100" width="281" x="-11" y="2408" as="geometry" />
        </mxCell>
        <mxCell id="aY2dbMntaScDE3_ggx9g-54" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;dashed=1;" value="&lt;div&gt;1、合并 &amp;amp; 去重：例如set.addAll(语义召回集合，关键字召回集合)，这样一举实现了文档的合并后和去重&lt;/div&gt;&lt;div&gt;2、过虑：根据业务需求对chunk对象的metadata中的业务字段进行过滤&lt;/div&gt;&lt;div&gt;3、粗排：基于规则/权重对去重后的chunk set进行权重计算，过滤不达标的数据&lt;/div&gt;&lt;div&gt;4、精排：使用重排模型对召回的chunk语义与用户的问题进行打分，看召回的内容是否可以回答用户的提问&lt;/div&gt;" vertex="1">
          <mxGeometry height="146" width="415" x="-217" y="3166" as="geometry" />
        </mxCell>
        <mxCell id="aY2dbMntaScDE3_ggx9g-59" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;dashed=1;" value="图片 → 切分 patch → patch embedding + 位置编码 → 视觉 token 序列" vertex="1">
          <mxGeometry height="53" width="283" x="-202" y="1235" as="geometry" />
        </mxCell>
        <mxCell id="aY2dbMntaScDE3_ggx9g-60" edge="1" parent="1" source="aY2dbMntaScDE3_ggx9g-59" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="aY2dbMntaScDE3_ggx9g-59">
