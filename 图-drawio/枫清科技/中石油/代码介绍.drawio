        <mxCell id="db-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=22;" value="智能审核助手 - 核心业务表结构（MySQL）" vertex="1">
          <mxGeometry height="35" width="700" x="30" y="20" as="geometry" />
        </mxCell>
        <mxCell id="db-note" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="实线：数据库外键；虚线：逻辑关联（通过 ID 或 JSON 配置关联）。表内格式为“字段：字段说明”；PK=主键，FK=外键，UK=唯一键。" vertex="1">
          <mxGeometry height="25" width="900" x="30" y="60" as="geometry" />
        </mxCell>
        <mxCell id="extract-title" parent="1" style="swimlane;html=1;rounded=0;startSize=28;horizontal=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" value="抽取链路" vertex="1">
          <mxGeometry height="750" width="1030" x="30" y="105" as="geometry" />
        </mxCell>
        <mxCell id="extract-requests" parent="1" style="shape=table;startSize=30;container=1;collapsible=1;childLayout=tableLayout;fixedRows=1;rowLines=1;html=1;align=center;resizeLast=1;fillColor=#ffffff;strokeColor=#6c8ebf;" value="extract_requests&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;id：主键；biz_id：业务申请标识；batch_id：对外批次号；status/phase/progress：处理进度；apply_payload：请求原文；result_payload：最终结果；notify_status：通知状态&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="210" x="60" y="155" as="geometry" />
        </mxCell>
        <mxCell id="extract-items" parent="1" style="shape=table;startSize=30;container=1;collapsible=1;childLayout=tableLayout;fixedRows=1;rowLines=1;html=1;align=center;resizeLast=1;fillColor=#ffffff;strokeColor=#6c8ebf;" value="extract_material_items&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;id：主键；extract_request_id：所属抽取批次；source_material_item_id：来源材料项；material_category：材料类别；material_item_name：材料名称；status：处理状态&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="220" x="340" y="155" as="geometry" />
        </mxCell>
        <mxCell id="extract-files" parent="1" style="shape=table;startSize=30;container=1;collapsible=1;childLayout=tableLayout;fixedRows=1;rowLines=1;html=1;align=center;resizeLast=1;fillColor=#ffffff;strokeColor=#6c8ebf;" value="extract_files&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;id：主键；material_item_id：所属材料项；source_file_id/filename：来源文件；url/storage_uri：下载与存储地址；sha256：文件摘要；status/error_message：处理结果&lt;/font&gt;" vertex="1">
