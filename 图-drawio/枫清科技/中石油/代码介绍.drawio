  <diagram id="2XSq1szUNsmDMd5OpfZs" name="接口说明">
    <mxGraphModel dx="1491" dy="524" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="PKGiXR_d_BkTq9GsaMVf-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;主要接口&lt;/th&gt;&lt;th&gt;作用&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;POST /title/evaluation/v1/auth/token&lt;/code&gt;&lt;/td&gt;&lt;td&gt;使用系统账号密码换取 JWT Token。&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;GET /title/evaluation/v1/health&lt;/code&gt;&lt;/td&gt;&lt;td&gt;仅检查服务是否存活。&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;GET /title/evaluation/v1/ready&lt;/code&gt;&lt;/td&gt;&lt;td&gt;检查主项目、MySQL、Redis 是否已就绪。&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;POST /title/evaluation/v1/extract&lt;/code&gt;&lt;/td&gt;&lt;td&gt;提交材料抽取任务。主项目会按材料项组织文件，并异步调用抽取器。&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;POST /title/evaluation/v1/extract/upload&lt;/code&gt;&lt;/td&gt;&lt;td&gt;直接上传 ZIP 材料包，跳过客户网关下载文件的流程。&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;GET /title/evaluation/v1/extract/{batch_id}/status&lt;/code&gt;&lt;/td&gt;&lt;td&gt;查询抽取任务进度、阶段和错误。&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;GET /title/evaluation/v1/extract/{batch_id}&lt;/code&gt;&lt;/td&gt;&lt;td&gt;查询最终抽取结果，格式与客户回调结果一致。&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;GET /title/evaluation/v1/extract/{batch_id}/raw&lt;/code&gt;&lt;/td&gt;&lt;td&gt;查询标准化前的原始抽取结果，主要用于诊断。&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;POST /title/evaluation/v1/extract/callback&lt;/code&gt;&lt;/td&gt;&lt;td&gt;抽取器完成识别后调用此接口，把 &lt;code&gt;task_id&lt;/code&gt; 与抽取结果交还主项目。&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;POST /title/evaluation/v1/audit&lt;/code&gt;&lt;/td&gt;&lt;td&gt;创建审核任务，根据已抽取字段执行审核规则。&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;GET /title/evaluation/v1/audit/{task_no}&lt;/code&gt;&lt;/td&gt;&lt;td&gt;查询审核任务的当前状态。&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;GET /title/evaluation/v1/audit/{task_no}/result&lt;/code&gt;&lt;/td&gt;&lt;td&gt;查询最终审核结果，格式与通知客户的结果一致。&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="359" width="806" x="-300" y="38" as="geometry" />
        </mxCell>
        <mxCell id="PKGiXR_d_BkTq9GsaMVf-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="审核管理后台&lt;div&gt;&lt;pre&gt;&lt;code&gt;/title/evaluation/v1/admin/audit&lt;/code&gt;&lt;/pre&gt;&lt;pre&gt;&lt;code&gt;&lt;br&gt;&lt;/code&gt;&lt;/pre&gt;&lt;pre&gt;&lt;code&gt;&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;接口类别&lt;/th&gt;&lt;th&gt;作用&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;/dashboard&lt;/code&gt;&lt;/td&gt;&lt;td&gt;查看审核任务、结果和运行概览。&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;/tasks&lt;/code&gt;、&lt;code&gt;/tasks/{task_no}&lt;/code&gt;&lt;/td&gt;&lt;td&gt;查询审核任务、材料项、规则执行日志和回调尝试记录。&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;/rules&lt;/code&gt;&lt;/td&gt;&lt;td&gt;审核规则的新增、查询、修改、启停、校验。&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;/rule-sets&lt;/code&gt;&lt;/td&gt;&lt;td&gt;管理规则集合及其中包含的规则。&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;/rule-match-configs&lt;/code&gt;&lt;/td&gt;&lt;td&gt;配置何种材料或字段应匹配哪套规则。&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;/input-schema&lt;/code&gt;&lt;/td&gt;&lt;td&gt;查询规则可使用的输入数据结构。&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;/runtime-tests/quickjs&lt;/code&gt;、&lt;code&gt;/zen-expression&lt;/code&gt;、&lt;code&gt;/zen-jdm&lt;/code&gt;&lt;/td&gt;&lt;td&gt;在线测试三种规则运行时。&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="303" width="835" x="-290" y="430" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
