        </mxCell>
        <mxCell id="116" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;会议群&lt;/font&gt;会议群同步所有人，抄送直属领导即可。" vertex="1">
          <mxGeometry height="58" width="195" x="1575" y="514" as="geometry" />
        </mxCell>
        <mxCell id="119" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;领导在场｜跨部门协调会&lt;/font&gt;（直接发群）&lt;div&gt;标题：XX 协调会行动纪要参会人：xxx&lt;/div&gt;&lt;div&gt;1、共识内容简要概括&lt;/div&gt;&lt;div&gt;2、待办清单：事项｜负责人｜完成时间抄送：直属领导&lt;/div&gt;&lt;div&gt;话术（群内）：各位，本次会议相关共识及待办整理如下，如有理解偏差请及时反馈。&lt;/div&gt;" vertex="1">
          <mxGeometry height="92" width="378" x="1853" y="497" as="geometry" />
        </mxCell>
        <mxCell id="123" parent="1" style="whiteSpace=wrap;html=1;rounded=1;align=left;" value="&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;领导在场&lt;/font&gt;｜&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;内部简单碰头会&lt;/font&gt;&lt;/font&gt;（极简版）直接群内文字：&lt;div&gt;本次会议确定事项：&lt;/div&gt;&lt;div&gt;1、A 工作由 XX 周五前完成&lt;/div&gt;&lt;div&gt;2、B 事项下周启动，有问题及时同步&lt;/div&gt;" vertex="1">
          <mxGeometry height="79" width="295" x="1855" y="349.5" as="geometry" />
        </mxCell>
        <mxCell id="128" edge="1" parent="1" source="125" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="127" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="125" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;font-size: 11px; text-wrap-mode: nowrap; background-color: rgb(255, 255, 255);&quot;&gt;个人专属任务&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="120" x="1279" y="640" as="geometry" />
        </mxCell>
        <mxCell id="127" parent="1" style="whiteSpace=wrap;html=1;rounded=1;align=left;" value="领导，刚会上安排的 XX 工作，我梳理下：xxx，我按这个推进，有卡点及时向您同步。作用：防止你理解偏差，单向确认指令。" vertex="1">
          <mxGeometry height="67" width="236" x="1478" y="636.5" as="geometry" />
        </mxCell>
        <mxCell id="129" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=middle;rounded=0;" value="核心思想：&#xa;内部小会、无跨部门、无重要约定：只发极简行动清单&#xa;多方协调、涉及权责、变更计划：必须纪要，群内抄送领导&#xa;领导缺席所有重要会议：纪要先上报领导审阅，再对外同步" vertex="1">
          <mxGeometry height="76" width="349" x="984" y="-193" as="geometry" />
        </mxCell>
        <mxCell id="134" edge="1" parent="1" source="130" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="133" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="138" edge="1" parent="1" source="130" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="137">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="142" edge="1" parent="1" source="130" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="141">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="146" edge="1" parent="1" source="130" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="145">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="130" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="核心思想：&lt;div&gt;带着方案提问题，不要只抛问题等答案；区分风险等级，把握上报时机&lt;/div&gt;" vertex="1">
          <mxGeometry height="63" width="168" x="1057" y="919" as="geometry" />
        </mxCell>
        <mxCell id="136" edge="1" parent="1" source="133" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="135" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="133" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="第1步：先自查，界定清楚问题" vertex="1">
          <mxGeometry height="57" width="196" x="1323" y="768.75" as="geometry" />
        </mxCell>
        <mxCell id="135" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="1、当前是什么任务、原定目标、计划节点；&lt;br&gt;2、准确困难是什么：资源不足？跨部门不配合？需求变动？技术卡点？时间不够？&lt;br&gt;3、自己已经尝试过哪些办法，结果如何；&lt;br&gt;4、问题影响：会不会延期？影响哪些上下游工作？潜在风险多大。" vertex="1">
          <mxGeometry height="82.5" width="457" x="1594" y="756" as="geometry" />
        </mxCell>
        <mxCell id="140" edge="1" parent="1" source="137" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="139" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="137" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="第2步：准备≥2 套可行解决方案（最重要）" vertex="1">
          <mxGeometry height="50" width="230" x="1323" y="888.25" as="geometry" />
        </mxCell>
        <mxCell id="139" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="不要只把难题上交。至少构思两种路径，并写明各自优缺点、需要领导支持点。&lt;div&gt;模板句式：&lt;/div&gt;&lt;div&gt;方案 A：xxxx；优势：xxx；弊端：xxx；需要支持：xxx&lt;/div&gt;&lt;div&gt;方案 B：xxxx；优势：xxx；弊端：xxx；需要支持：xxx&lt;/div&gt;" vertex="1">
          <mxGeometry height="84" width="386" x="1594" y="871.25" as="geometry" />
        </mxCell>
        <mxCell id="144" edge="1" parent="1" source="141" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="143" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="141" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="第 3 步：选择合适时机向上同步，请求决策" vertex="1">
          <mxGeometry height="51" width="240" x="1323" y="989.75" as="geometry" />
        </mxCell>
        <mxCell id="143" parent="1" style="whiteSpace=wrap;html=1;align=left;rounded=1;" value="区分两类情况：&lt;div&gt;1）紧急、会造成重大损失 / 马上逾期：立刻沟通（当面、电话、加急消息）&lt;/div&gt;&lt;div&gt;2）短期尚可推进，暂时不致命：整理好信息，选择领导空闲时段沟通&lt;/div&gt;" vertex="1">
          <mxGeometry height="66" width="414" x="1594" y="982.25" as="geometry" />
        </mxCell>
        <mxCell id="148" edge="1" parent="1" source="145" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="147" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="145" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="第 4 步：接收决策、落地执行、持续同步进展" vertex="1">
          <mxGeometry height="52" width="255" x="1323" y="1084.75" as="geometry" />
        </mxCell>
        <mxCell id="150" edge="1" parent="1" source="147" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="149" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="147" parent="1" style="whiteSpace=wrap;html=1;align=left;rounded=1;" value="领导选定方案后：&lt;br&gt;&lt;br&gt;1、复述确认一遍，避免理解偏差；&lt;br&gt;2、推进过程有新变化，持续同步；&lt;br&gt;3、任务闭环后复盘。" vertex="1">
          <mxGeometry height="84.75" width="212" x="1616" y="1068.25" as="geometry" />
        </mxCell>
        <mxCell id="149" parent="1" style="whiteSpace=wrap;html=1;align=left;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" value="复盘的内容容需要发给领导吗?" vertex="1">
          <mxGeometry height="60" width="120" x="1954" y="1080.625" as="geometry" />
        </mxCell>
        <mxCell id="154" edge="1" parent="1" source="151" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="153" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="156" edge="1" parent="1" source="151" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="155">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="151" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="什么问题需要上报领导" vertex="1">
          <mxGeometry height="60" width="120" x="1057" y="1212" as="geometry" />
        </mxCell>
        <mxCell id="158" edge="1" parent="1" source="153" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="159" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1896" y="1339" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="161" edge="1" parent="1" source="153" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="160">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="163" edge="1" parent="1" source="153" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="162">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="153" parent="1" style="whiteSpace=wrap;html=1;rounded=1;align=left;" value="⚠️必须及时上报，不能私自决定：&lt;br&gt;&lt;br&gt;1、无法按时交付，会影响整体排期；&lt;br&gt;2、需要额外人力、预算、资源；&lt;br&gt;3、跨部门协调僵持，对方不配合，自己推动不动；&lt;br&gt;4、目标 / 需求存在冲突、风险上升；&lt;br&gt;5、需要变更原有方案、对外承诺。&lt;br&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;红线：风险已经出现，但刻意隐瞒，等到最后一刻爆发，属于重大职场失误。早暴露风险责任更小。&lt;/font&gt;" vertex="1">
          <mxGeometry height="160" width="406" x="1267" y="1259" as="geometry" />
        </mxCell>
        <mxCell id="155" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="✅可以自己协调解决（不用找领导）&#xa;内部流程问题、简单沟通对接、小范围时间微调、不影响整体目标，在你的权责内。" vertex="1">
          <mxGeometry height="60" width="360" x="1267" y="1181" as="geometry" />
        </mxCell>
        <mxCell id="159" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;跨部门配合受阻，自己协调不动&lt;/h1&gt;&lt;p&gt;领导，向您同步下 XX 工作进展。目前卡在 XX 环节，XX 部门需要 XX 支持，我已经和对方对接 2 次，对方表示暂时无法配合。&lt;/p&gt;&lt;div style=&quot;font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-variant-emoji: normal; font-stretch: normal; font-family: ui-sans-serif, system-ui, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; line-height: 24px; flex: 0 1 auto; flex-direction: row; justify-content: normal; align-items: normal; padding: 0px; margin: 0px; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0);&quot;&gt;&lt;/div&gt;&lt;p&gt;&lt;br/&gt;给到两个思路：&lt;/p&gt;&lt;div style=&quot;font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-variant-emoji: normal; font-stretch: normal; font-family: ui-sans-serif, system-ui, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; line-height: 24px; flex: 0 1 auto; flex-direction: row; justify-content: normal; align-items: normal; padding: 0px; margin: 0px; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0);&quot;&gt;&lt;/div&gt;&lt;p&gt;&lt;br/&gt;方案 1：【内容】，优点 xx，需要您出面和对方负责人沟通协调；&lt;/p&gt;&lt;div style=&quot;font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-variant-emoji: normal; font-stretch: normal; font-family: ui-sans-serif, system-ui, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; line-height: 24px; flex: 0 1 auto; flex-direction: row; justify-content: normal; align-items: normal; padding: 0px; margin: 0px; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0);&quot;&gt;&lt;/div&gt;&lt;p&gt;&lt;br/&gt;方案 2：【内容】，适当调整交付时间，降低依赖。&lt;/p&gt;&lt;div style=&quot;font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-variant-emoji: normal; font-stretch: normal; font-family: ui-sans-serif, system-ui, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; line-height: 24px; flex: 0 1 auto; flex-direction: row; justify-content: normal; align-items: normal; padding: 0px; margin: 0px; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0);&quot;&gt;&lt;/div&gt;&lt;p&gt;&lt;br/&gt;麻烦您看下倾向哪种方式，我马上推进。&lt;/p&gt;" vertex="1">
          <mxGeometry height="251" width="406" x="2200" y="1099" as="geometry" />
        </mxCell>
        <mxCell id="160" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;工作量过大，无法按期完成&lt;/h1&gt;&lt;p&gt;领导，原定 XX 节点交付 XX 任务。按现有工作量，保质完成难度较大。&lt;/p&gt;&lt;div style=&quot;font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-variant-emoji: normal; font-stretch: normal; font-family: ui-sans-serif, system-ui, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; line-height: 24px; flex: 0 1 auto; flex-direction: row; justify-content: normal; align-items: normal; padding: 0px; margin: 0px; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0);&quot;&gt;&lt;/div&gt;&lt;p&gt;&lt;br/&gt;方案 A：保持原时间，优先完成核心内容，次要部分延后；&lt;/p&gt;&lt;div style=&quot;font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-variant-emoji: normal; font-stretch: normal; font-family: ui-sans-serif, system-ui, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; line-height: 24px; flex: 0 1 auto; flex-direction: row; justify-content: normal; align-items: normal; padding: 0px; margin: 0px; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0);&quot;&gt;&lt;/div&gt;&lt;p&gt;&lt;br/&gt;方案 B：完整交付全部内容，交付时间顺延至 XX 日。&lt;/p&gt;&lt;div style=&quot;font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-variant-emoji: normal; font-stretch: normal; font-family: ui-sans-serif, system-ui, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; line-height: 24px; flex: 0 1 auto; flex-direction: row; justify-content: normal; align-items: normal; padding: 0px; margin: 0px; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0);&quot;&gt;&lt;/div&gt;&lt;p&gt;&lt;br/&gt;请您定夺。&lt;/p&gt;" vertex="1">
          <mxGeometry height="192" width="386" x="2200" y="1403" as="geometry" />
        </mxCell>
        <mxCell id="162" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;执行发现方案存在漏洞&lt;/h1&gt;&lt;p&gt;领导，在推进 XX 事项时，发现原方案存在 XX 隐患，如果按原计划执行，后续可能出现 XX 问题。我梳理了两种调整方案……&lt;/p&gt;" vertex="1">
