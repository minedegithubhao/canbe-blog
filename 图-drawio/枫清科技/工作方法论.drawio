        <mxCell id="113" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;会议群&lt;/font&gt;只梳理行动项清单（任务、责任人、截止时间）" vertex="1">
